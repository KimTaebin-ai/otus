Vagrant.configure("2") do |config|
  config.vm.box = "bento/ubuntu-24.04"

  config.vm.synced_folder File.expand_path("..", __dir__), "/vagrant"

  config.vm.provider "virtualbox" do |vb|
    vb.memory = 4096
    vb.cpus = 2
  end

  config.vm.network "forwarded_port",
    guest: 8443,
    host: 8443,
    host_ip: "127.0.0.1"

  # 빌드 도구와 rootless Podman 실행 환경 (최초 프로비저닝)
  config.vm.provision "shell", inline: <<-SHELL
    set -eu
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y podman make curl openssl ca-certificates \
      uidmap slirp4netns fuse-overlayfs dbus-user-session
    loginctl enable-linger vagrant
  SHELL

  # Vagrant 실행 시마다 Podman 컨테이너 시작
  config.vm.provision "shell",
    path: "start-podman.sh",
    args: ["/vagrant"],
    privileged: false,
    run: "always"
end
