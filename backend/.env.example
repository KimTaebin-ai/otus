# Copy to backend/.env for local development (`cp .env.example .env`).
# backend/.env is gitignored; keep it chmod 600.

# Dev database from `podman run ... otus-dev-db` (see CLAUDE.md)
DATABASE_URL=postgres://otus:otus_dev@127.0.0.1:5433/otus

BIND_ADDR=127.0.0.1:3000
RUST_LOG=otus_backend=debug,tower_http=debug

# Uploaded PDFs are stored here under UUID filenames
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=20971520

# Demo login (issue #1). Must be false in production.
DEMO_LOGIN_ENABLED=true

# AES-256-GCM key for bank account numbers: 32 random bytes, base64.
# Generate with `openssl rand -base64 32`. Losing it makes stored account numbers
# unrecoverable; keep a backup apart from database backups. Never commit a real key.
BANK_ACCOUNT_KEY=
BANK_ACCOUNT_KEY_ID=1

# AES-256-GCM key for stored PDFs (ID cards, 주민등록초본, 통장사본), separate from the bank
# key. Same rules: `openssl rand -base64 32`, back it up, never commit it.
FILE_ENCRYPTION_KEY=
FILE_ENCRYPTION_KEY_ID=1

# 42 OAuth app (profile.intra.42.fr -> Settings -> API). Never commit real values.
FORTY_TWO_CLIENT_ID=
FORTY_TWO_CLIENT_SECRET=
# Must match a redirect URI registered with the 42 app exactly, and its origin must be APP_ORIGIN.
#   dev (`bun run start` on :4200, proxied to :3000):
FORTY_TWO_REDIRECT_URI=http://localhost:4200/api/auth/42/callback
#   pod (https://localhost:8443): set in deploy/otus-pod.yaml, not read from this file.
#   FORTY_TWO_REDIRECT_URI=https://localhost:8443/api/auth/42/callback
# Only members of this campus may log in (42 Gyeongsan = 69, from the 42 API /v2/campus)
FORTY_TWO_CAMPUS_ID=69

# Browser origin allowed for state-changing requests (CSRF Origin check).
# http://localhost:4200 for `bun run start`, https://localhost:8443 for the pod.
APP_ORIGIN=http://localhost:4200
# Issue #9: several origins (student + admin), comma-separated; wins over APP_ORIGIN.
# Dev admin app runs on :4201.
# APP_ORIGINS=http://localhost:4200,http://localhost:4201
# Admin 42 callback (register this exact URI in the 42 app too):
# FORTY_TWO_ADMIN_REDIRECT_URI=http://localhost:4201/api/auth/42/callback
# Staff roles are granted only via this allowlist at 42 login (login=role, roles:
# operator/accountant/admin). Removing a login revokes the role at next login.
# STAFF_ROLE_ALLOWLIST=some42login=operator,other42login=accountant
# Optional admin notices via SMTP. Addresses are <42 login>@MAIL_RECIPIENT_DOMAIN.
# Leave all three required values unset to disable email (service notices remain).
# Local dummy SMTP configuration; replace for production. Never commit credentials.
# MAIL_RECIPIENT_DOMAIN=example.test
# SMTP_HOST=127.0.0.1
# SMTP_PORT=2525
# SMTP_FROM=OTUS <noreply@example.test>
# SMTP_TLS=none
# Production: SMTP_TLS=tls (465) or starttls (587), verified TLS required.
# SMTP_USERNAME=
# SMTP_PASSWORD_FILE=/run/secrets/otus-backend/smtp-password
# SMTP_PASSWORD= may be used for local development instead of a secret file.

# Optional accountant ZIP limits (encrypted temporary artifacts).
# MAX_EXPORT_USERS=100
# MAX_EXPORT_BYTES=268435456
# EXPORT_TTL_SECONDS=900
# EXPORT_REQUEST_INTERVAL_SECONDS=300
