# Copy to `.env` in the REPO ROOT (`cp .env.example .env`) to let `make demo`
# offer the real 42 login next to the demo login. `.env` is git-ignored; never
# commit real values. Leave both empty/unset for today's behaviour (42 off;
# if previously enabled, also clear deploy/secrets.yaml or `make demo-clean`).

# 42 OAuth app credentials (UID / Secret). Create or choose the app in intra:
# profile -> Settings -> API (oauth applications), and register these redirect
# URIs VERBATIM, one per line, or the real login is rejected by 42:
#   https://localhost:8443/api/auth/42/callback
#   https://admin.localhost:8443/api/auth/42/callback
# `make demo` copies the two values below into deploy/secrets.yaml (the backend
# secret) on every run; the redirect URIs and campus (42 Gyeongsan = 69) are
# fixed for the demo pod in deploy/otus-pod.yaml.
FORTY_TWO_CLIENT_ID=
FORTY_TWO_CLIENT_SECRET=
