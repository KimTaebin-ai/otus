# 저장소 루트에서 복사: cp -n deploy/.env.example deploy/.env
# 실제 값을 채운 뒤: chmod 600 deploy/.env && ./deploy/start-podman.sh
# GitHub Actions 배포는 이 파일을 채운 내용을 PRODUCTION_ENV secret에 넣는다.
# 한 줄에 KEY=value 형식으로 작성한다. ${변수}, $(명령) 등은 확장되지 않는다.

# 학생 앱 주소. 실제 도메인 또는 IPv4 주소로 바꾼다.
# 직접 접속은 HTTPS/8443, 앞단 프록시가 443을 제공하면 :8443을 뺀다.
APP_ORIGIN=https://otus.example.com:8443

# 관리자 앱은 학생 앱과 다른 DNS 이름이 필요하다 (IP 주소 불가).
# 두 호스트의 DNS가 배포 서버를 가리키도록 설정한다.
# 관리자 앱을 외부에 제공하지 않으면 이 항목을 생략한다.
# 로컬 APP_ORIGIN=https://localhost:8443에서는 생략 시 https://admin.localhost:8443을 사용한다.
ADMIN_SITE_ADDRESS=https://admin.otus.example.com:8443

# 생략하면 위 학생·관리자 주소로 자동 구성된다.
# 직접 지정할 경우 학생·관리자 origin을 모두 포함해야 한다 (누락 시 배포 중단).
# APP_ORIGINS=https://otus.example.com:8443,https://admin.otus.example.com:8443
# SITE_ADDRESS도 APP_ORIGIN의 호스트에서 자동 설정된다.
# SITE_ADDRESS=otus.example.com

# 운영은 42 OAuth로 로그인한다. 실제 앱 자격 증명을 채운다.
# 아래 두 콜백 URI를 42 OAuth 앱에 등록하고 위 주소와 함께 수정한다.
FORTY_TWO_CLIENT_ID=
FORTY_TWO_CLIENT_SECRET=
FORTY_TWO_REDIRECT_URI=https://otus.example.com:8443/api/auth/42/callback
# 관리자 콜백은 ADMIN_SITE_ADDRESS와 OAuth 자격 증명이 있으면 자동 설정된다.
# FORTY_TWO_ADMIN_REDIRECT_URI=https://admin.otus.example.com:8443/api/auth/42/callback
FORTY_TWO_CAMPUS_ID=69

# 관리자 권한을 받을 실제 42 login을 지정한다. 비워 두면 권한을 부여하지 않는다.
# 형식: ops_login=operator,account_login=accountant,admin_login=admin
STAFF_ROLE_ALLOWLIST=

# 운영 기본값. 공개 데모가 필요하면 두 값을 모두 true로 바꾼다.
# GitHub Actions는 OTUS_REQUIRE_OAUTH=true로 실행하여 두 값을 false로 강제한다.
# OTUS_REQUIRE_OAUTH는 스크립트 실행 환경변수이므로 이 파일에 추가하지 않는다.
DEMO_LOGIN_ENABLED=false
DEMO_LOGIN_ALLOW_PUBLIC=false

# 이메일 발송 (선택): 사용할 때 아래 항목의 주석을 풀고 실제 값을 채운다.
# MAIL_RECIPIENT_DOMAIN은 수신자 도메인이다. 수신 주소는 <42 login>@도메인.
# 도메인·서버·발신 주소를 모두 생략하면 이메일 발송이 비활성화된다.
# MAIL_RECIPIENT_DOMAIN=students.example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_TLS=starttls
# SMTP_FROM="OTUS <noreply@example.com>"
# SMTP_USERNAME=noreply@example.com
# SMTP_PASSWORD='replace-with-smtp-password'
# SMTP_FROM은 발신 주소, SMTP_USERNAME은 SMTP 서비스의 로그인 계정이다.
# 서비스가 465 포트를 사용하면 SMTP_PORT=465, SMTP_TLS=tls로 설정한다.
# 인증을 사용하면 SMTP_USERNAME과 SMTP_PASSWORD를 함께 설정한다.
# 비밀번호는 자동으로 secret 파일에 저장·마운트된다. SMTP_PASSWORD_FILE은 넣지 않는다.
# 비밀번호 변경은 다음 배포에 반영된다. 생략하면 기존 값을 재사용하고,
# SMTP_PASSWORD=로 비우면 삭제한다 (인증도 끄려면 SMTP_USERNAME도 비운다).
# 이메일 발송을 끄려면 MAIL_RECIPIENT_DOMAIN·SMTP_HOST·SMTP_FROM을 모두 생략/비운다.

# DB 비밀번호·암호화 키는 생략하면 기존 deploy/secrets.yaml 값을 재사용하고,
# 첫 배포에서는 자동 생성한다. 아래 항목은 직접 지정할 때만 값을 채워 활성화한다.
# deploy/secrets.yaml은 데이터와 함께 백업한다. 기존 값의 변경은 별도 이관이 필요하다.
# POSTGRES_PASSWORD=
# OTUS_APP_PASSWORD=
# DATABASE_URL은 pod 내부 DB만 지원하며, 비밀번호는 OTUS_APP_PASSWORD와 같아야 한다.
# URL의 비밀번호에 특수문자가 있으면 URL 인코딩한다.
# DATABASE_URL=postgres://otus:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:5432/otus
# 두 키는 각각 `openssl rand -base64 32`로 생성한 서로 다른 값을 사용한다.
# BANK_ACCOUNT_KEY=
# FILE_ENCRYPTION_KEY=

# 선택 설정: 아래는 컨테이너/백엔드 기본값이다.
# BANK_ACCOUNT_KEY_ID=1
# FILE_ENCRYPTION_KEY_ID=1
# BIND_ADDR=127.0.0.1:3000
# UPLOAD_DIR=/data/uploads
# MAX_UPLOAD_BYTES=20971520
# CLAMAV_ADDR=127.0.0.1:3310
# RUST_LOG=info
# FORTY_TWO_API_BASE=https://api.intra.42.fr

# start-podman.sh에서 허용하는 변수만 사용할 수 있다.
# backend/.env.example의 ZIP 제한 변수는 현재 이 배포 스크립트가 지원하지 않는다.
